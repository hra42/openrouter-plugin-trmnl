  <div class="layout">
    <div class="richtext richtext--left">
      <div class="content content--left gap" data-content-limiter="true">
        {{ choices[0].message.content | markdown_to_html }}
      </div>
    </div>
  </div>
  <div class="title_bar">
    <img src="https://openrouter.ai/favicon.ico" class="image image-stroke image-stroke--black image-stroke--small" alt="OpenRouter plugin icon">
    <span class="title">{{ model | split: "/" | last | upcase }}</span>
    <span class="instance">{{ instance_name }}</span>
  </div>